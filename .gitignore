# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- node (nothing in this repo needs it, but keep it out if you add tooling) ---
node_modules/
npm-debug.log*
package-lock.json

# --- python ---
__pycache__/
*.pyc

# --- CTF Analyst Academy ---
# exported progress snapshots are personal state, not project content
ctf-analyst-academy/*progress*.json
ctf-analyst-academy/*.save.json
# never commit captured evidence or scratch dumps from a lab session
ctf-analyst-academy/scratch/

# --- CyberLab V4 ---
# real environment / secrets (the committed template is .env.example)
.env
cyberlab/.env
# local SQLite databases and session/log scratch
cyberlab/storage/*
!cyberlab/storage/.gitkeep
*.sqlite3
*.log
# CyberLab's public/assets are tracked. They contain CyberLab's own auth
# assets plus byte-for-byte copies of every CTF Analyst Academy runtime
# asset, so cyberlab/ can be deployed without the sibling academy folder.
# Refresh those copies with cyberlab/bin/sync-assets.php after academy edits.
# local php-wasm test harness dependencies. The harness lockfile is tracked
# so GitHub Actions can use npm ci/cache reproducibly.
cyberlab/tests/wasm/node_modules/
cyberlab/tests/wasm/node_modules
!cyberlab/tests/wasm/package-lock.json

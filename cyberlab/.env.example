# ============================================================================
# CyberLab V4 - contoh konfigurasi environment
# Salin file ini menjadi ".env" lalu isi nilainya:  cp .env.example .env
# File .env TIDAK boleh di-commit ke Git (sudah masuk .gitignore).
# ============================================================================

# --- Database (produksi: MySQL 8+ / MariaDB) -------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cyberlab_db
DB_USER=cyberlab
DB_PASSWORD=ganti-dengan-password-database-anda

# --- Database (pengembangan & pengujian tanpa MySQL) -----------------------
# Aktifkan dengan DB_DRIVER=sqlite. Path relatif dihitung dari folder
# cyberlab/. File database dibuat otomatis oleh bin/migrate.php.
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=storage/cyberlab.sqlite3

# --- Sesi --------------------------------------------------------------------
# Set SESSION_SECURE=1 bila situs dilayani lewat HTTPS (atau di belakang
# reverse-proxy HTTPS). Kosongkan untuk deteksi otomatis.
# SESSION_SECURE=1

# --- Penilaian challenge tipe "code" (CODE-001, CODE-002) ------------------
# Dua challenge dinilai dengan menjalankan tabel tes JavaScript di server
# memakai Node.js dalam sandbox vm (timeout, tanpa akses filesystem/jaringan).
# Isi path binary node untuk mengaktifkan; kosongkan untuk menonaktifkan
# (submission code akan dijawab jujur "code_runner_unavailable", poin tidak
# diberikan daripada diberikan tanpa verifikasi).
CODE_RUNNER_NODE=
